# Supabase Public Client Configuration
# Obtain these values from your Supabase Project Settings -> API
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key-here

# IMPORTANT SECURITY RULES:
# 1. Only the Anon (public) key should ever be provided here.
# 2. NEVER expose the Supabase service_role key in frontend code or environment files.
# 3. Database access is strictly secured via PostgreSQL Row Level Security (RLS).
